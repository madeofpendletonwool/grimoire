# Grimoire configuration. Copy to ".env" and fill in real values.
# The real ".env" is gitignored — never commit secrets.

# ---- Q&A chat (Anthropic Messages API) ----
# Works against Anthropic directly or any Anthropic-compatible endpoint.
# z.ai (GLM) example values are shown below.
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=glm-4.6

# For Anthropic directly instead, use:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- Fallback provider (optional) ----
# A standby the chat switches to when the primary fails for a reason a second
# account wouldn't share: quota or credit exhausted, a rate limit, an expired
# key, an overloaded or unreachable endpoint. A malformed request is not
# retried elsewhere — it would fail the same way there. Failover happens before
# any of the answer has been streamed, so a reader never sees two half-answers
# spliced together; the handoff is logged (host and model only, never a key).
# Only the key is required: the base URL defaults to Anthropic's and the model
# to ANTHROPIC_MODEL above.
# ANTHROPIC_FALLBACK_BASE_URL=https://api.anthropic.com
# ANTHROPIC_FALLBACK_API_KEY=replace-me
# ANTHROPIC_FALLBACK_MODEL=claude-3-5-sonnet-20241022
# Further rungs are numbered and tried in order; the chain stops at the first
# missing key, so leave no gaps.
# Any Anthropic-compatible endpoint works here — a second account on the same
# gateway, a different gateway, or a local proxy that speaks /v1/messages.
# ANTHROPIC_FALLBACK_2_BASE_URL=https://api.z.ai/api/anthropic
# ANTHROPIC_FALLBACK_2_API_KEY=replace-me
# ANTHROPIC_FALLBACK_2_MODEL=glm-4.5-air

# ---- Semantic retrieval (OpenAI-compatible embeddings API) ----
# Optional. Off by default — retrieval is FTS5 (keyword) only when unset, which
# is fine for exact terms and rule numbers. Set both a key and a model to enable
# embeddings-based recall, so a question like "does my hexproof guy die to a
# board wipe?" finds the destroy/damage rules even though no words overlap.
# Anthropic has no embeddings API, so this targets the OpenAI /embeddings
# contract that compatible gateways also serve.
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=replace-me
# EMBEDDINGS_MODEL=text-embedding-3-small
# z.ai (GLM) example instead:
# EMBEDDINGS_BASE_URL=https://api.z.ai/v1
# EMBEDDINGS_MODEL=embedding-3

# ---- Server ----
GRIMOIRE_ADDR=:8080
GRIMOIRE_PORT=8080
GRIMOIRE_DB=data/grimoire.db

# ---- Accounts ----
# There is no seeded password: the first person to open an unclaimed install
# creates the keeper account from the login screen, and that first account is
# the admin. The admin then invites friends via single-use links from Settings
# -> Invitations; account creation otherwise closes behind the first keeper.
# Passwords are argon2id-hashed in the same SQLite file as everything else, so
# nothing here is a secret.
GRIMOIRE_SESSION_TTL=720h
# How long a freshly minted invite link stays usable (default 168h / 7d).
# Set to 0 for invites that never expire.
# GRIMOIRE_INVITE_TTL=168h
# GRIMOIRE_OPEN_REGISTRATION=false

# ---- Q&A answer cache ----
# Repeat (or grounding-equivalent) questions return instantly from cache.
# A rules reindex invalidates affected entries on its own: the retrieved
# source set changes, so the cache key changes. Default 168h (7d).
# GRIMOIRE_ANSWER_CACHE_TTL=168h

# ---- MTG card lookup (Scryfall) ----
# No API key required. Override only if you run a Scryfall mirror.
# SCRYFALL_BASE_URL=https://api.scryfall.com

# ---- D&D entity lookup (Open5e) ----
# No API key required. The chat grounds questions about named D&D spells,
# monsters, items, and feats in the SRD text from Open5e, the way MTG questions
# are grounded via Scryfall. Override only for a mirror.
# OPEN5E_BASE_URL=https://api.open5e.com

# ---- Data sources (optional overrides) ----
# MTG_RULES_URL=https://media.wizards.com/2026/downloads/MagicCompRules%2020260807.txt
# MTGJSON_URL=https://mtgjson.com/api/v5/AtomicCards.json.gz
# DND_REPO=downfallx/dnd-5e-srd-markdown
# DND_REF=master

# ---- Local D&D books (optional) ----
# A directory of markdown/text documents indexed alongside the SRD: your PHB,
# DMG, monster books, the Sage Advice compendium — anything you want the sage
# grounded in that the SRD doesn't cover. Convert PDFs first:
#   pip install pymupdf
#   python3 scripts/extract-dnd-pdfs.py /path/to/pdfs --out /path/to/docs
# then point DND_DOCS_DIR at the output and rebuild the index
# (docker compose run --rm grimoire index, or grimoire index).
# The books are for your personal reference only — do not commit them.
# DND_DOCS_DIR=/path/to/dnd-docs

# ---- Deck builder EDHREC enrichment (optional) ----
# Off by default. When enabled, the deck builder re-ranks its candidates with
# EDHREC's per-commander synergy data and serves Commander Spellbook combos.
# EDHREC has no official API — this reads the same Next.js JSON routes a
# browser does, caches responses on disk, and spaces requests ~1s apart.
# If the routes ever change, the builder silently falls back to its local
# engine (MTGJSON ranks + text search); nothing breaks.
# GRIMOIRE_EDHREC=1
# GRIMOIRE_EDHREC_CACHE_DIR=data/edhrec-cache
